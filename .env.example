# ==============================================================================
# NETLIFY & VITE ENVIRONMENT VARIABLES (Set in Netlify Site settings → Environment variables)
# ==============================================================================

# VITE_GEMINI_API_KEY: Netlify & Vite client environment variable for Gemini AI Features
# Recommended Value: Your Gemini API Key (e.g. AIzaSy...)
VITE_GEMINI_API_KEY=""

# VITE_ADMIN_EMAIL: Optional custom administrator login email on Netlify
# Default if omitted: hr.vercito@gmail.com
VITE_ADMIN_EMAIL="hr.vercito@gmail.com"

# VITE_ADMIN_PASSWORD: Optional custom administrator login password on Netlify
# Default if omitted: vercito2026!
VITE_ADMIN_PASSWORD="vercito2026!"

# ==============================================================================
# SERVER-SIDE ENVIRONMENT VARIABLES (For Express Backend / Cloud Run)
# ==============================================================================

# GEMINI_API_KEY: Required for backend Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

